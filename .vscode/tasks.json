{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "vault secrets apply all",
            "type": "shell",
            "command": "terraform apply -input=false -auto-approve",
            "options": {
                "cwd": "${workspaceFolder}/vault-secrets/"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
        },
        {
            "label": "terraform format all",
            "type": "shell",
            "command": "./scripts/terraform_fmt_all.sh",
            "options": {
                "cwd": "${workspaceFolder}/"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
        },
        {
            "label": "vault login",
            "type": "shell",
            "command": " vault login -method=userpass username=admin password=$(cat ./secrets/userpass.admin.pass)",
            "options": {
                "cwd": "${workspaceFolder}/",
                "env": {
                    "VAULT_ADDR": "https://vault.tuana9a.com"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
        },
        {
            "label": "vault unseal",
            "type": "shell",
            "command": "./unseal_vault.sh",
            "options": {
                "cwd": "${workspaceFolder}/",
                "env": {
                    "VAULT_ADDR": "https://vault.tuana9a.com",
                    "KUBECONFIG": "./secrets/.kube/oidc@anor-londo-cluster.yml"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
        },
        {
            "label": "get argocd admin password",
            "type": "shell",
            "command": "kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d ; echo",
            "options": {
                "cwd": "${workspaceFolder}/",
                "env": {
                    "VAULT_ADDR": "https://vault.tuana9a.com",
                    "KUBECONFIG": "./secrets/.kube/oidc@anor-londo-cluster.yml"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
        },
        {
            "label": "get grafana admin password",
            "type": "shell",
            "command": "kubectl -n grafana get secret grafana -o jsonpath=\"{.data.admin-password}\" | base64 --decode ; echo",
            "options": {
                "cwd": "${workspaceFolder}/",
                "env": {
                    "VAULT_ADDR": "https://vault.tuana9a.com",
                    "KUBECONFIG": "./secrets/.kube/oidc@anor-londo-cluster.yml"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
        },
    ]
}